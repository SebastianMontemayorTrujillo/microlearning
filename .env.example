# Copy this file to .env in the repository root. Never put this key in frontend/.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Leave blank for a SQLite database at backend/microlearn.db.
DATABASE_URL=
AI_DAILY_BUDGET_USD=0.25
AI_INPUT_USD_PER_MILLION=0.40
AI_OUTPUT_USD_PER_MILLION=1.60
CONTENT_BUFFER_LOW=20
CONTENT_BUFFER_TARGET=100
AI_BATCH_SIZE=6
FRONTEND_ORIGIN=http://localhost:3000
LEARNING_TIMEZONE=America/Monterrey

